# Reproducible approximation of Prydwen's published C1 Sucrose variant.
# Public assumptions: C1 Mizuki / C6 Sucrose / C0 Odette / C2 Cryo
# Traveler, the published weapons and sets, 0.5 s swaps, and four 21.1 s
# rotations. Artifact substats are intentionally omitted here so gcsim's
# KQMS optimizer can assign the 20 fixed + 20 liquid rolls.
#
# Refinement assumptions are explicit because Prydwen's team card does not
# display them: R5 for gacha/craftable 4-star weapons and the story-capped R3
# Exaiphanes Blade. These assumptions must not be confused with a copied user
# showcase build.

mizuki char lvl=90/90 cons=1 talent=9,9,9;
mizuki add weapon="thewidsith" refine=5 lvl=90/90;
mizuki add set="viridescentvenerer" count=4;
mizuki add stats hp=4780 atk=311 em=374 cr=0.311;
mizuki add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacrificialfragments" refine=5 lvl=90/90;
sucrose add set="instructor" count=4;
# Four 4-star Instructor pieces (flower/feather/EM sands/EM goblet) and a
# 5-star off-set EM circlet. This lets the optimizer apply the KQMS 4-star
# artifact roll penalty instead of treating Instructor as five 5-star pieces.
sucrose add stats hp=3571 atk=232 em=139+139+187;
sucrose add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*2 em=16.6488*6 cr=0.027804*7 cd=0.055608*5;

odette char lvl=90/90 cons=0 talent=9,9,9;
odette add weapon="finaleofthedeep" refine=5 lvl=90/90;
odette add set="heartofthefurnace" count=4;
odette add stats hp=4780 atk=311 atk%=0.932 cr=0.311;
odette add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

aethercryo char lvl=90/90 cons=2 talent=9,9,9;
aethercryo add weapon="exaiphanesblade" refine=3 lvl=90/90;
aethercryo add set="adaycarvedfromrisingwinds" count=4;
aethercryo add stats hp=4780 atk=311 atk%=0.932 cr=0.311;
# Prydwen specifies 125% ER for this variant. Five total KQMS ER rolls give
# 127.55% on the profile (before Traveler's separate story enhancement).
aethercryo add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*5 em=19.82*3 cr=0.0331*2 cd=0.0662*12;

options iteration=5000 duration=84.4;
options swap_delay=30;

target lvl=100 resist=0.1 radius=2 pos=0,2.4;

active odette;

# Published loop: Odette EE > Cryo Traveler ECQ > Sucrose Ed > Mizuki E(Q)
# > Sucrose Ed. N1 is required by gcsim before the sword Charged Attack.
# Readiness guards model the real result when Sacrificial Fragments does not
# reset and when an optional Burst is unavailable; they prevent impossible
# cooldown/energy retry spam from inflating the timeline.
for let i=0; i<4; i=i+1 {
  odette skill, skill;

  aethercryo skill;
  # Traveler must first accumulate Icepoint/Frostglow. The displayed ECQ
  # shorthand applies from the second rotation onward.
  if i > 0 {
    aethercryo attack:1, charge;
    if .aethercryo.burst.ready && .aethercryo.energy == .aethercryo.energymax {
      aethercryo burst;
    }
  }

  wait(.sucrose.swap.cd);
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack:1;
  }
  wait(.sucrose.swap.cd);

  mizuki skill;
  if .mizuki.burst.ready && .mizuki.energy == .mizuki.energymax {
    mizuki burst;
  }
  while .mizuki.mods.dreamdrifter-state {
    wait(1);
  }

  wait(.sucrose.swap.cd);
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack:1;
  }
  wait(.sucrose.swap.cd);
}
