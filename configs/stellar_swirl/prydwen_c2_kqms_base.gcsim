# C2 extension of the reproducible Prydwen C1 Sucrose-variant approximation.
# See prydwen_c1_kqms_base.gcsim for the source/assumption notes. Substats are
# omitted so the KQMS optimizer can account for C2 when distributing rolls.

mizuki char lvl=90/90 cons=2 talent=9,9,9;
mizuki add weapon="thewidsith" refine=5 lvl=90/90;
mizuki add set="viridescentvenerer" count=4;
mizuki add stats hp=4780 atk=311 em=374 cr=0.311;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacrificialfragments" refine=5 lvl=90/90;
sucrose add set="instructor" count=4;
sucrose add stats hp=3571 atk=232 em=139+139+187;

odette char lvl=90/90 cons=0 talent=9,9,9;
odette add weapon="finaleofthedeep" refine=5 lvl=90/90;
odette add set="heartofthefurnace" count=4;
odette add stats hp=4780 atk=311 atk%=0.932 cr=0.311;

aethercryo char lvl=90/90 cons=2 talent=9,9,9;
aethercryo add weapon="exaiphanesblade" refine=3 lvl=90/90;
aethercryo add set="adaycarvedfromrisingwinds" count=4;
aethercryo add stats hp=4780 atk=311 atk%=0.932 cr=0.311;

options iteration=1000 duration=84.4;
options swap_delay=30;

target lvl=100 resist=0.1 radius=2 pos=0,2.4;

active odette;

for let i=0; i<4; i=i+1 {
  odette skill, skill;

  aethercryo skill;
  if i > 0 {
    aethercryo attack:1, charge;
    if .aethercryo.burst.ready && .aethercryo.energy == .aethercryo.energymax {
      aethercryo burst;
    }
  }

  wait(.sucrose.swap.cd);
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack:1;
  }
  wait(.sucrose.swap.cd);

  mizuki skill;
  if .mizuki.burst.ready && .mizuki.energy == .mizuki.energymax {
    mizuki burst;
  }
  while .mizuki.mods.dreamdrifter-state {
    wait(1);
  }

  wait(.sucrose.swap.cd);
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack:1;
  }
  wait(.sucrose.swap.cd);
}
