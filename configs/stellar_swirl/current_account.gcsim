# Exact builds imported from the account snapshot supplied for this project.
# Artifact lines contain the five pieces' main and substats; set and weapon
# bonuses are applied separately by gcsim.

mizuki char lvl=90/90 cons=2 talent=2,9,6 +params=[witch_revelation=0];
mizuki add weapon="lostprayertothesacredwinds" refine=1 lvl=90/90;
mizuki add set="wandererstroupe" count=2;
mizuki add set="aubadeofmorningstarandmoon" count=2;
mizuki add stats hp=5348 hp%=0.041 atk=350 atk%=0.082 def=16 def%=0.073 em=538 cr=0.435 cd=1.134 er=0.136;

odette char lvl=90/90 cons=0 talent=2,9,6;
odette add weapon="primordialjadecutter" refine=1 lvl=90/90;
odette add set="heartofthefurnace" count=4;
odette add stats hp=5288 def%=0.284 def=118 cr=0.424 cd=1.089 atk=340 er=0.207 atk%=1.084 hp%=0.041;

aethercryo char lvl=90/90 cons=2 talent=7,7,8;
aethercryo add weapon="exaiphanesblade" refine=3 lvl=90/90;
aethercryo add set="gladiatorsfinale" count=2;
aethercryo add set="disenchantmentindeepshadow" count=2;
aethercryo add stats hp=5557 em=42 cr=0.35 er=0.175 cd=1.275 atk=311 atk%=1.247 hp%=0.105 def%=0.175 def=39;

sucrose char lvl=90/90 cons=6 talent=6,10,9;
sucrose add weapon="wanderingevenstar" refine=4 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 def=102 em=659 er=0.486 cr=0.171 atk=346 atk%=0.269 cd=0.42 hp%=0.093;

options iteration=5000 duration=61.18;
options swap_delay=30;

target lvl=100 resist=0.1 radius=2 pos=0,2.4;

active aethercryo;

# Updated live rotation. Every Mizuki window has exactly nine continuous hits.
# Sucrose uses E immediately before all three windows and, from the second
# rotation onward, once after the preceding Mizuki window. This gives the five
# Sucrose Stellar Swirls visible in the screenshot. The opener is Traveler E,
# then Sucrose E; later Traveler turns use E N1C Q.
for let i=0; i<3; i=i+1 {
  if i == 0 {
    aethercryo skill;
    wait(.sucrose.swap.cd);
    sucrose skill, dash;
  } else {
    wait(.sucrose.swap.cd);
    sucrose skill, dash;
    wait(.aethercryo.swap.cd);
    aethercryo skill;
    aethercryo attack:1, charge;
    while .aethercryo.energy < .aethercryo.energymax {
      wait(1);
    }
    aethercryo burst;
    sucrose skill, dash;
  }

  wait(.sucrose.swap.cd);
  odette skill, skill;
  mizuki skill;
  # The ninth continuous hit lands 408f after Skill activation. Skill followed
  # by wait consumes 50f, so 359 additional frames retain exactly nine ticks.
  wait(359);

  # The following rotation's Sucrose swap cancels Dreamdrifter after nine hits.
  # After the final window, swap back to Odette (as in the result screenshot)
  # so Mizuki cannot continue ticking during the remaining recording time.
  if i == 2 {
    wait(.odette.swap.cd);
    odette dash;
  }
}
